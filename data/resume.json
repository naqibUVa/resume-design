  "projects": [
    {
      "id": "pr-1",
      "title": "FlowLOT: Linearized Optimal Transport for Flow Cytometry Analysis",
      "description": "Developed FlowLOT, an optimal transport-based framework that represents patient-level flow cytometry measurements as discrete probability distributions and maps them into compact, fixed-length embeddings. The framework enables interpretable analysis of high-dimensional single-cell data, supporting classification, visualization, and continuous outcome prediction within a unified mathematical framework. Demonstrated its utility for measurable residual disease (MRD) estimation in acute myeloid leukemia (AML), achieving transparent and biologically interpretable patient-level modeling.",
      "tech": [
        "Optimal Transport",
        "Linear Optimal Transport",
        "Flow Cytometry",
        "MRD Estimation",
        "Computational Hematology",
        "AML",
        "Python",
        "HPC",
        "Deepsets",
        "Pointnet++",
        "DGCNN"
      ],
      "demo": "",
      "source": "https://github.com/naqibUVa/FlowLOT_v1",
      "paper": "https://arxiv.org/abs/2609.17906",
      "include": true
    },
    {
      "id": "pr-2",
      "title": "Metaphase Chromosome Analysis with Iterative Indirect Immunofluorescence Imaging (4i)",
      "description": "Investigates how chromosome passenger complex (CPC) signaling and chromosome condensation are coordinated during mitosis using high-dimensional multiplex imaging. Develops optimal transport-based methods to quantify, visualize, and compare chromosome-scale variation across cell lines, studying how chromosome geometry influences protein localization and chromosomal organization.",
      "tech": [
        "4i Imaging",
        "Multiplex Imaging",
        "Spatial Biology",
        "Chromosome Biology",
        "Chromosome Passenger Complex",
        "Python",
        "Image Processing"
      ],
      "demo": "",
      "source": "",
      "paper": "",
      "include": true
    },
    {
      "id": "pr-3",
      "title": "Quantifying Nuclear Structures in Digital Pathology Using Transport-Based Morphometry (TBM)",
      "description": "Develops transport-based morphometry (TBM) methods grounded in optimal transport theory to quantify nuclear chromatin organization directly from microscopy images. By representing nuclei relative to a common template, these methods provide interpretable and robust morphological descriptors that reveal cancer-associated structural variation across tissue types and imaging protocols.",
      "tech": [
        "Digital Pathology",
        "Whole Slide Imaging",
        "Transport-Based Morphometry",
        "Optimal Transport",
        "Nuclear Morphometry",
        "Python"
      ],
      "demo": "",
      "source": "",
      "paper": "https://doi.org/10.1002/cyto.a.24917",
      "include": true
    },
    {
      "id": "pr-4",
      "title": "Computational Autofluorescence Correction for Cyclic Immunofluorescence (Genentech Summer Internship Project)",
      "description": "Designed and implemented scalable computational imaging workflows for autofluorescence correction, artifact removal, and image restoration in high-plex cIF experiments. Leveraged Zarr-based storage, Dask, and parallel/distributed computing to analyze terabyte-scale whole-slide and TMA proteomics and spatial transcriptomics datasets generated on the Lunaphore COMET platform.",
      "tech": [
        "Multiplex Imaging",
        "Spatial Proteomics",
        "Single-Cell Analysis",
        "Python",
        "Cyclic-IF",
        "Dask",
        "Zarr"
      ],
      "demo": "",
