  "projects": [
    {
      "id": "pr-1",
      "title": "SparseServe",
      "description": "Open-source inference server for **sparsely-activated transformers**. Ships a scheduler that batches across experts instead of across requests, which is where the throughput actually hides.\n\n- 3.1× throughput over a dense baseline at equal accuracy\n- Drop-in `openai`-compatible HTTP API\n- Used by three external research groups",
      "tech": [
        "Rust",
        "CUDA",
        "PyTorch",
        "gRPC"
      ],
      "demo": "https://sparseserve.example.dev",
