profiling,\n  author    = {Raman, Priya and Doe, Jane},\n  title     = {Profiling Training Runs by Cost per Unit of Learning},\n  booktitle = {Proceedings of the ACM Symposium on Cloud Computing (SoCC)},\n  year      = {2024},\n  pages     = {212--225},\n  doi       = {10.1145/3698038.3698061}\n}\n\n@article{smith2023survey,\n  author  = {Smith, John A. and Doe, Jane and Okonkwo, Ada and Lindqvist, Erik},\n  title   = {A Survey of Efficient Inference for Mixture-of-Experts Models},\n  journal = {ACM Computing Surveys},\n  year    = {2023},\n  volume  = {56},\n  number  = {3},\n  pages   = {1--41},\n  doi     = {10.1145/3624010}\n}\n\n@incollection{doe2023chapter,\n  author    = {Doe, Jane},\n  title     = {Systems Constraints in Modern Model Serving},\n  booktitle = {Handbook of Practical Machine Learning Systems},\n  editor    = {Alvarez, Mar{\\'i}a and Chen, Wei},\n  publisher = {Cambridge University Press},\n  year      = {2023},\n  pages     = {145--172},\n  isbn      = {978-1-108-00000-0}\n}\n\n@phdthesis{doe2027thesis,\n  author  = {Doe, Jane},\n  title   = {Efficient Inference for Sparsely-Activated Neural Networks},\n  school  = {Your University},\n  year    = {2027},\n  type    = {PhD thesis},\n  address = {Boston, MA, USA},\n  note    = {In preparation}\n}\n\n@misc{doe2025preprint,\n  author       = {Doe, Jane and Okonkwo, Ada},\n  title        = {Scheduling Across Experts, Not Across Requests},\n  year         = {2025},\n  eprint       = {2505.01234},\n  archivePrefix = {arXiv},\n  primaryClass = {cs.LG},\n  url          = {https://arxiv.org/abs/2505.01234},\n  note         = {Preprint, under review}\n}\n\n@techreport{lab2024report,\n  author      = {Doe, Jane and Smith, John A.},\n  title       = {Benchmarking Sparse Serving Stacks: A Reproducibility Report},\n  institution = {University Systems \\& Learning Lab},\n  year        = {2024},\n  number      = {TR-2024-07},\n  url         = {https://lab.example.edu/tr/2024-07.pdf}\n}\n"